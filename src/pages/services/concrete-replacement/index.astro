const faqs = [
  {
    q: 'What does concrete replacement include?',
    a: 'Everything: breaking out and hauling away the old surface, excavation, regrading, a compacted new base, and a fresh pour with a clean finish. Your written quote covers the job end to end.',
  },
  {
    q: 'How disruptive is a replacement job?',
    a: 'Most residential replacements, a driveway, walkway or patio, take a few days on site plus curing time. We keep the site tidy, barricade fresh concrete, and confirm the schedule in writing before we start.',
  },
  {
    q: 'Can you replace asphalt with concrete?',
    a: 'Yes, that is a common job. We remove the asphalt, build a proper compacted base, and pour concrete in its place for a surface that outlasts asphalt many times over with far less maintenance.',
  },
  {
    q: 'Is replacement always better than repair?',
    a: 'No. If the damage is isolated and the concrete is otherwise sound, a repair is the better value. We recommend replacement when cracking, heaving or surface failure is widespread, and we show you the evidence either way.',
  },
  {
    q: 'What can you replace?',
    a: 'Driveways, patios, walkways, sidewalks, porches, steps and slabs, residential and commercial. If it is worn-out concrete, we can take it out and pour it new.',
  },
];
