const faqs = [
  {
    q: 'Can you resurface my porch instead of rebuilding it?',
    a: 'If the structure underneath is sound, yes, a new surface layer can bring a worn porch back. If the porch is sinking, pulling away from the house or crumbling through, a rebuild is the honest answer. We check the structure first and tell you which one you have.',
  },
  {
    q: 'Why is my porch pulling away from the house?',
    a: 'Usually settlement in the fill underneath, often where water has washed fines out from below the slab. We address the base when we rebuild, so the new porch stays put.',
  },
  {
    q: 'Can you pour a new porch where there is none?',
    a: 'Yes. We handle the full job: excavation, base, forming to the height your door needs, pouring and finishing, including any steps the entrance requires.',
  },
  {
    q: 'Do porch jobs come with railings?',
    a: 'We pour the concrete structure. Where local code requires a guard or railing, we tell you during the quote so the finished entrance is compliant.',
  },
  {
    q: 'How long does a porch job take?',
    a: 'A typical residential porch repair or pour is a few days on site, plus curing time before heavy use. We confirm the schedule in writing and stick to it.',
  },
];
