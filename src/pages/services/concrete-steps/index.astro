---
import InnerPage from '../../../components/InnerPage.astro';

const faqs = [
  {
    q: 'Can crumbling concrete steps be repaired?',
    a: 'If the damage is surface scaling or a chipped nosing here and there, a repair can restore them. If the steps are crumbling through, rocking, or the risers are uneven, replacement is safer and usually not much more money. We will tell you honestly which one your steps need.',
  },
  {
    q: 'What makes a set of steps safe?',
    a: 'Consistent riser heights, adequate tread depth, and a textured, slip-resistant surface. Uneven risers are the classic trip hazard, and we form every step to a consistent dimension.',
  },
  {
    q: 'Can you match new steps to my existing porch?',
    a: 'Yes. We form and pour the steps to meet the porch at the right height and width, with a matching finish, so the whole entrance reads as one piece.',
  },
  {
    q: 'Do I need railings on my front steps?',
    a: 'It depends on the rise. Where local code requires a guard or handrail, we flag it during the quote so your finished steps are compliant.',
  },
  {
    q: 'How long before I can use new steps?',
    a: 'Light foot traffic after 24 to 48 hours, normal use after about a week. We leave clear curing guidance and make sure you have safe access in the meantime.',
  },
];
---

<InnerPage
  title="Concrete Steps in Toronto & the GTA | Concrete Toronto"
  description="Concrete step repair and replacement across Toronto and the GTA. Safe, even front and back steps backed by a 2-year warranty. Free quotes."
  canonical="https://concrete-toronto.ca/services/concrete-steps/"
  extraSchema={[{
    '@type': 'Service',
