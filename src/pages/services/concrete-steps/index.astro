    serviceType: 'Concrete step installation and repair',
    description: 'Concrete step repair and replacement across Toronto and the Greater Toronto Area, backed by a 2-year warranty.',
    provider: { '@id': 'https://concrete-toronto.ca/#business' },
    areaServed: 'Greater Toronto Area',
    url: 'https://concrete-toronto.ca/services/concrete-steps/',
  }]}
