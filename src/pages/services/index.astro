---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { SERVICES, faqSchema, breadcrumbSchema } from '../../data/site.js';

const faqs = [
  {
    q: 'How do I know which service I actually need?',
    a: 'Send us a photo or two with your quote request and we will tell you straight. As a rule of thumb, repair is for surfaces with isolated cracks or wear, replacement is for concrete that is failing across the board, and the installation services cover anything you want poured new.',
  },
  {
    q: 'Can you combine several services in one visit?',
    a: 'Yes, and it is one of the most common requests we get. Homeowners often pair a new driveway with front steps or a walkway. Combining the work means one quote, one schedule and one cleanup.',
  },
  {
    q: 'How much do your services cost?',
    a: 'Every job is different, so we quote each one individually rather than posting flat rates. Quotes are free and without obligation, and you will always know the price in writing before any work starts.',
  },
  {
    q: 'What areas do you cover?',
    a: 'We serve Toronto, Scarborough, Markham, Richmond Hill, Vaughan, North York, Pickering, Oshawa, Ajax, Whitby and the entire Greater Toronto Area. If you are nearby but not sure you are in our range, ask. The answer is usually yes.',
  },
  {
    q: 'Is your work guaranteed?',
    a: 'Yes. Every service we offer is backed by a 2-year warranty and a satisfaction guarantee. If something we built fails within that window, we come back and make it right.',
  },
];
---

<Base
  title="Concrete Services in Toronto & the GTA | Concrete Toronto"
  description="Concrete driveways, patios, walkways, sidewalks, porches, steps, foundations and slabs, plus repair, replacement and parging across Toronto and the GTA. Free quotes, 2-year warranty."
  canonical="https://concrete-toronto.ca/services/"
  ogTitle="Concrete Services in Toronto & the GTA"
  jsonld={[
    {
      '@type': 'CollectionPage',
      '@id': 'https://concrete-toronto.ca/services/',
      url: 'https://concrete-toronto.ca/services/',
      name: 'Concrete Services in Toronto & the GTA',
      description: 'Concrete driveways, patios, walkways, sidewalks, porches, steps, foundations and slabs, plus repair, replacement and parging across Toronto and the GTA.',
      about: { '@id': 'https://concrete-toronto.ca/#business' },
      mainEntity: { '@id': 'https://concrete-toronto.ca/services/#list' },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://concrete-toronto.ca/services/#list',
      name: 'All concrete and parging services',
      itemListElement: SERVICES.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.name,
        url: `https://concrete-toronto.ca/services/${s.slug}/`,
      })),
    },
    breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Services' }]),
    faqSchema(faqs),
  ]}
>

<!-- ============== PAGE HERO ============== -->
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span class="here">Services</span>
    </nav>
    <p class="kicker">All services · Toronto &amp; the GTA</p>
    <h1>Our concrete and parging <span class="em">services</span></h1>
    <p class="sub">Every concrete and parging service we offer across Toronto and the GTA, in one place. Pick the job you need done and get a free quote.</p>
    <div class="hero-cta">
      <a href="#quote" class="btn btn-primary">Get My Free Quote <span class="arrow">→</span></a>
    </div>
    <div class="hero-badges">
      <span class="hbadge"><span class="tick">✓</span> 2-Year Warranty</span>
      <span class="hbadge"><span class="tick">✓</span> Satisfaction Guaranteed</span>
      <span class="hbadge"><span class="tick">✓</span> On Schedule, Every Time</span>
      <span class="hbadge"><span class="tick">✓</span> 15 Years of Local Experience</span>
    </div>
  </div>
</section>

<!-- ============== MAIN CONTENT ============== -->
<section class="section">
  <div class="wrap">
    <div class="content-grid">
      <div class="prose">
        <p>This page lays out every one of our concrete and parging services in one place. <a href="/">Concrete Toronto</a> looks after the concrete around your home or business from the ground down: driveways, patios, walkways, sidewalks, porches, steps, foundations and slabs, plus repair and replacement for surfaces that are worn out, and parging for foundation walls and basements. All of it is done by our own crew, and all of it carries our 2-year warranty.</p>
        <p>Most calls we get start the same way. A homeowner notices the driveway is cracking, the front steps are crumbling, or the sidewalk has heaved out of level, and they want a straight answer about what it will take to fix it. That is what we do. We look at the job, explain the options in plain language, and put the price in writing. No pressure, no surprises.</p>

        <h2>The services we offer</h2>
        <p>Here is the full list. Each one has its own page with details on how we do the work and what to expect on the day.</p>
        <ul>
          {SERVICES.map((s) => (
            <li><strong><a href={`/services/${s.slug}/`}>{s.name}.</a></strong> {s.blurb}.</li>
          ))}
        </ul>

        <h2>Installation, repair or replacement?</h2>
        <p>The right call depends on the condition of what is there now. Hairline cracks and small spalled patches are usually a <a href="/services/concrete-repair/">repair</a>. When cracks run the full width of a slab, sections have heaved or sunk, or the surface is crumbling across most of its area, <a href="/services/concrete-replacement/">replacement</a> is the smarter spend. And if the concrete is bare or was never poured, that is a straight installation. We will give you an honest read when we quote, because a repair on concrete that needs replacing wastes your money, and replacing concrete that only needs a repair wastes even more.</p>
        <p>Whatever the job, the fundamentals do not change: proper site preparation, a stable base, the right mix for Ontario freeze-thaw conditions, a careful finish and enough cure time. That discipline is what our 2-year warranty is built on. We serve the whole GTA, so see the full list of <a href="/locations/">areas we serve</a> if you are outside the city.</p>

        <h2>Why homeowners choose us</h2>
        <p>We are a local team with 15 years of experience and hundreds of concrete jobs behind us across Toronto and the surrounding area. We show up when we say we will, we stick to the schedule, and we stand behind the finished work.</p>
        <ul>
          <li>2-year warranty on every job</li>
          <li>Satisfaction guaranteed</li>
          <li>Free, no-obligation quotes</li>
          <li>One crew for concrete and parging, so combined jobs get one quote and one schedule</li>
        </ul>

        <p>Getting started is simple. Send the form with a few details, we look at the job, and you get a written price. For the full walkthrough from consultation to cleanup, see <a href="/#process">our six-step process</a>. Not sure which service fits? Describe the problem in the form and we will figure it out when we quote.</p>
      </div>
      <aside class="side-card reveal">
        <h3>Get a free quote</h3>
        <p>Tell us which service you need, or describe the problem and let us figure it out. We reply with a clear written price.</p>
        <ul>
          <li><span class="tick">✓</span> Free, no-obligation estimate</li>
          <li><span class="tick">✓</span> 2-year warranty on our work</li>
          <li><span class="tick">✓</span> Satisfaction guaranteed</li>
        </ul>
        <a href="#quote" class="btn btn-primary">Get My Free Quote</a>
      </aside>
    </div>
  </div>
</section>

<!-- ============== MINI GALLERY ============== -->
<section class="section work" style="padding-block: clamp(48px, 6vw, 84px);">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="kicker">Our work</p>
      <h2>Recent concrete work</h2>
    </div>
    <div class="gallery" style="grid-auto-rows: 240px;">
      <div class="gtile reveal"><img src="/assets/img/new-concrete-front-walkway-toronto.jpg" width="1200" height="1600" alt="Freshly poured concrete front walkway at a Toronto home" loading="lazy" decoding="async" /></div>
      <div class="gtile wide reveal"><img src="/assets/img/concrete-hand-trowel-finishing-toronto.jpg" width="1600" height="1066" alt="Hand trowel finishing on fresh concrete in Toronto" loading="lazy" decoding="async" /></div>
      <div class="gtile reveal"><img src="/assets/img/curved-concrete-walkway-entrance-toronto.jpg" width="1280" height="1600" alt="Curved broom-finish concrete walkway at a Toronto front entrance" loading="lazy" decoding="async" /></div>
    </div>
  </div>
</section>

<!-- ============== RELATED LINKS ============== -->
<section class="section related">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="kicker">Pick a service</p>
      <h2>All concrete &amp; parging services</h2>
    </div>
    <div class="related-grid">
      {SERVICES.map((s) => (
        <a class="svc-card reveal" href={`/services/${s.slug}/`}><span class="mk">→</span><span class="body"><strong>{s.name}</strong><span>{s.blurb}</span></span><span class="go">→</span></a>
      ))}
    </div>
  </div>
</section>

<QuoteForm
  intro="Send a few details about the job, any of our services, and we will come back with a clear written quote."
  messagePlaceholder="e.g. The driveway is cracked and heaved, and I'd like a price on new front steps too"
/>

<!-- ============== FAQ ============== -->
<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="kicker center">Good to know</p>
      <h2>Questions about our services, answered</h2>
    </div>

    <div class="faq-list reveal">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-q">{f.q} <span class="pm">+</span></button>
          <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============== FINAL CTA ============== -->
<section class="section final">
  <div class="wrap">
    <h2 class="reveal">Get your free quote today</h2>
    <p class="reveal">Tell us what you need done and we will send a clear, written quote. No pressure, no surprises.</p>
    <div class="btns reveal">
      <a href="#quote" class="btn btn-light">Get My Free Quote</a>
    </div>
  </div>
</section>

</Base>
