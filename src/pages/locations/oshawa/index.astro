---
import InnerPage from '../../../components/InnerPage.astro';

const faqs = [
  {
    q: 'How much does concrete work cost in Oshawa?',
    a: 'It depends on the size of the job and how much prep the site needs. Every quote from Concrete Toronto is free and in writing, so you know the exact price before any work starts.',
  },
  {
    q: 'Do you serve all of Oshawa?',
    a: 'Yes. We work across the whole city, from the older streets near the lake and downtown up through the north end and the newer communities along Winchester and Harmony.',
  },
  {
    q: 'Do you handle commercial concrete in Oshawa?',
    a: 'Yes. We handle commercial projects including parking spaces, sidewalks, foundations and other concrete structures for businesses across Oshawa and Durham Region.',
  },
  {
    q: 'My older home needs the driveway, steps and porch done. Can you handle all three?',
    a: 'Yes, that is a very common Oshawa job. One crew, one quote, one schedule, and the finishes match across the whole frontage.',
  },
  {
    q: 'How do I get a quote?',
    a: 'Fill out the free quote form and we will get back to you with an estimate. Prefer to talk? Call us at (289) 906-0097.',
  },
