  }]}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Areas', href: '/locations/' }, { label: 'Oshawa' }]}
  kicker="Serving Oshawa"
  h1="Concrete work in"
  h1Em="Oshawa"
  sub="Concrete driveways, patios, walkways, porches, steps and commercial concrete across Oshawa, backed by a 2-year warranty."
