  geoLon={-78.8658}
  extraSchema={[{
    '@type': 'Service',
    name: 'Concrete Contractor in Oshawa',
    serviceType: 'Concrete installation, repair and parging',
    description: 'Concrete driveways, patios, walkways, sidewalks, porches, steps, foundations, slabs, repair, replacement and parging for homes and businesses across Oshawa, Ontario. 2-year warranty and free quotes.',
