const faqs = [
  {
    q: 'How much does concrete work cost in Markham?',
    a: 'It depends on the size of the job and how much prep the site needs. Every quote from Concrete Toronto is free and in writing, so you know the exact price before any work starts.',
  },
  {
    q: 'My subdivision driveway is only a decade old and already cracking. Why?',
    a: 'Builder-grade flatwork is often poured thin over minimal base. It looks fine for a few years, then freeze-thaw finds the weak spots. When we replace it, we excavate to a proper depth and compact a real granular base so the new pour lasts.',
  },
  {
    q: 'Can you widen my driveway?',
    a: 'Often, yes. Widening involves municipal rules about driveway widths and curb cuts, and our contractors know the local requirements. We will tell you what is allowed on your lot before we quote the work.',
  },
  {
    q: 'Do you work in both old Unionville and the newer neighbourhoods?',
    a: 'Yes. We work across Markham, from the heritage streets of Unionville to Milliken, Cornell, Wismer and the newer north end. The concrete problems differ by era, and we quote each job on what it actually needs.',
  },
  {
    q: 'How do I get a quote?',
    a: 'Fill out the free quote form and we will get back to you with an estimate. Prefer to talk? Call us at (289) 906-0097.',
  },
];
