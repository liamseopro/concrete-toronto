---
import InnerPage from '../../../components/InnerPage.astro';

const faqs = [
  {
    q: 'How much should I expect concrete to cost in Whitby?',
    a: 'It depends on the job: heritage-street work can mean matching old finishes, while newer homes usually need base prep redone. Every quote from Concrete Toronto is free and in writing, so the price is fixed before work starts.',
  },
  {
    q: 'Do you work on heritage homes in downtown Whitby?',
    a: 'Yes. Older homes need a careful touch: matching existing finishes, protecting mature landscaping, and respecting the character of the street. We have done concrete work on plenty of older GTA homes.',
  },
  {
    q: 'Do you serve Brooklin and the north end?',
    a: 'Yes. We work across Whitby, from the downtown heritage streets up through Brooklin and the newer communities in the north end.',
  },
  {
    q: 'Can you pour a driveway and patio in one visit?',
    a: 'Yes. Bundling flatwork into one visit gets you one quote, one schedule and one cleanup, and usually a better overall price than splitting the work.',
  },
  {
    q: 'How do I get my Whitby quote started?',
    a: 'The free quote form is the fastest way: photos and a few details, and we reply with a written estimate. Or call us at (289) 906-0097.',
  },
];
---

<InnerPage
