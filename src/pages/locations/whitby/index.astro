  geoLon={-78.9429}
  extraSchema={[{
    '@type': 'Service',
    name: 'Concrete Contractor in Whitby',
    serviceType: 'Concrete installation, repair and parging',
    description: 'Concrete contractor in Whitby, from the downtown heritage streets to Brooklin and the north end: driveways, patios, porches, steps and parging for century homes and newer builds, with finishes matched to the house and base prep done properly. 2-year warranty and free written quotes.',
