---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { LOCATIONS, faqSchema, breadcrumbSchema } from '../../data/site.js';

const faqs = [
  {
    q: 'Which cities do you serve?',
    a: 'We serve Toronto, Scarborough, Markham, Richmond Hill, Vaughan, North York, Pickering, Oshawa, Ajax and Whitby, plus the entire Greater Toronto Area. If you live between two of those cities, you are almost certainly in our area too. Send the form and we will confirm right away.',
  },
  {
    q: 'Do you charge more for jobs outside Toronto?',
    a: 'No. Quotes are based on the work itself: the size of the job, the condition of the site and how much prep is needed. A house in Oshawa or Whitby is quoted the same way as a house in Toronto.',
  },
  {
    q: "My city isn't on the list. Can you still help?",
    a: 'Quite possibly. We regularly take on jobs in smaller communities around the cities listed here, especially when we already have work booked nearby. Send the form with your address and we will let you know quickly, with no obligation either way.',
  },
  {
    q: 'Is the warranty the same in every city?',
    a: 'Yes. Every job carries our 2-year warranty and our satisfaction guarantee, whether the house is in North York or Oshawa. Distance never changes how we stand behind the work.',
  },
  {
    q: 'How do quotes work?',
    a: 'Send the form with a few details and photos of the project, and we put together a free, written estimate. For larger or unusual jobs we may come by to measure before we finalize anything.',
  },
];
---

<Base
  title="Concrete Contractor Service Areas Across the GTA"
  description="Concrete Toronto serves Toronto, Scarborough, Markham, Richmond Hill, Vaughan, North York, Pickering, Oshawa, Ajax, Whitby and the entire GTA. Free quotes, 2-year warranty."
  canonical="https://concrete-toronto.ca/locations/"
  ogTitle="Concrete Contractor Service Areas Across the GTA"
  jsonld={[
    {
      '@type': 'CollectionPage',
      '@id': 'https://concrete-toronto.ca/locations/',
      url: 'https://concrete-toronto.ca/locations/',
      name: 'Concrete Contractor Service Areas Across the GTA',
      description: 'Concrete and parging services in Toronto, Scarborough, Markham, Richmond Hill, Vaughan, North York, Pickering, Oshawa, Ajax, Whitby and the entire GTA.',
      about: { '@id': 'https://concrete-toronto.ca/#business' },
      mainEntity: { '@id': 'https://concrete-toronto.ca/locations/#arealist' },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://concrete-toronto.ca/locations/#arealist',
      name: 'Cities served by Concrete Toronto',
      numberOfItems: 10,
      itemListElement: LOCATIONS.map((l, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: l.name,
        url: `https://concrete-toronto.ca/locations/${l.slug}/`,
      })),
    },
    breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Service Areas' }]),
    faqSchema(faqs),
  ]}
>

<!-- ============== PAGE HERO ============== -->
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span class="here">Service Areas</span>
    </nav>
    <p class="kicker">Service areas · Toronto &amp; the GTA</p>
    <h1>Concrete service areas across the <span class="em">GTA</span></h1>
    <p class="sub">From downtown Toronto east along the lake to Oshawa and north to Richmond Hill. Same crew, same warranty, wherever your property is.</p>
    <div class="hero-cta">
      <a href="#quote" class="btn btn-primary">Get My Free Quote <span class="arrow">→</span></a>
    </div>
    <div class="hero-badges">
      <span class="hbadge"><span class="tick">✓</span> 2-Year Warranty</span>
      <span class="hbadge"><span class="tick">✓</span> Satisfaction Guaranteed</span>
      <span class="hbadge"><span class="tick">✓</span> On Schedule, Every Time</span>
      <span class="hbadge"><span class="tick">✓</span> 15 Years of Local Experience</span>
    </div>
  </div>
</section>

<!-- ============== MAIN CONTENT ============== -->
<section class="section">
  <div class="wrap">
    <div class="content-grid">
      <div class="prose">
        <p>Concrete Toronto is based in Toronto, and our service areas cover the city plus the GTA communities around it. The same crew that pours a driveway in North York on Tuesday is replacing a walkway in Pickering on Thursday, and our 2-year warranty travels with us to every job. If your city is on this page, you get the same free quote, the same materials and the same finish we would put on a house on our own street.</p>

        <p>Covering this much ground keeps us honest about how different the housing stock is from one city to the next. Downtown Toronto has century homes on tight lots. Scarborough and North York are full of postwar bungalows whose original concrete has taken seventy winters of freeze and thaw. Vaughan, Markham and Richmond Hill lean newer, where builder-grade flatwork often needs attention within its first decade or two. We quote every job on what it actually needs, not on a template.</p>

        <h2>What we do in every city we serve</h2>
        <p>Everything on our <a href="/services/">services page</a> is available in every area listed below. The calls we get most often:</p>
        <ul>
          <li><strong><a href="/services/concrete-driveways/">Concrete driveways</a></strong>: new pours and full replacements on a compacted base</li>
          <li><strong><a href="/services/concrete-patios/">Patios</a></strong>, <strong><a href="/services/concrete-walkways/">walkways</a></strong> and <strong><a href="/services/concrete-sidewalks/">sidewalks</a></strong>: flatwork that stays level through freeze-thaw</li>
          <li><strong><a href="/services/concrete-porches/">Porches</a></strong> and <strong><a href="/services/concrete-steps/">steps</a></strong>: safe, solid entrances</li>
          <li><strong><a href="/services/concrete-foundations/">Foundations</a></strong> and <strong><a href="/services/concrete-slabs/">slabs</a></strong>: for additions, garages and commercial work</li>
          <li><strong><a href="/services/concrete-repair/">Repair</a></strong>, <strong><a href="/services/concrete-replacement/">replacement</a></strong> and <strong><a href="/services/parging/">parging</a></strong> for surfaces and walls that need attention</li>
        </ul>
        <p>Not sure which of those you need? Describe the project in the form, or snap a photo, and we will sort that out when we put your quote together.</p>

        <h2>GTA service areas we cover</h2>
        <p>Pick your city below for local details, or skip straight to the quote form and just tell us where you are. We currently serve:</p>
        <ul>
          {LOCATIONS.map((l) => (
            <li><a href={`/locations/${l.slug}/`}>{l.name}</a></li>
          ))}
        </ul>
        <p>Plenty of smaller communities sit between these cities, and we take jobs in them all the time. If you are within a reasonable drive of any city above, consider yourself covered and send the form. Worst case, we tell you straight that we cannot make the distance work for your project.</p>

        <h2>Why homeowners across the GTA choose us</h2>
        <p>We treat your property like our own, whichever city it sits in. That means straight answers, tidy job sites, and a schedule we actually keep.</p>
        <ul>
          <li>2-year warranty on every job, in every city</li>
          <li>Satisfaction guaranteed</li>
          <li>Free, no-obligation quotes</li>
          <li>15 years of local experience, hundreds of concrete jobs completed</li>
        </ul>

        <p>Getting started works the same wherever you live. Send the form with a couple of photos, we send back a clear written quote, and once you approve it we book the job and show up when we say we will. You can read about <a href="/#process">our six-step process</a> on the <a href="/">Concrete Toronto homepage</a>, then reach out whenever you are ready.</p>
      </div>
      <aside class="side-card reveal">
        <h3>Get a free quote</h3>
        <p>Tell us your city and what needs doing, and we will send back a clear quote, anywhere in our service area.</p>
        <ul>
          <li><span class="tick">✓</span> Free, no-obligation estimate</li>
          <li><span class="tick">✓</span> 2-year warranty on our work</li>
          <li><span class="tick">✓</span> Satisfaction guaranteed</li>
        </ul>
        <a href="#quote" class="btn btn-primary">Get My Free Quote</a>
      </aside>
    </div>
  </div>
</section>

<!-- ============== MINI GALLERY ============== -->
<section class="section work" style="padding-block: clamp(48px, 6vw, 84px);">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="kicker">Our work</p>
      <h2>Concrete work from around the GTA</h2>
    </div>
    <div class="gallery" style="grid-auto-rows: 240px;">
      <div class="gtile reveal"><img src="/assets/img/concrete-sidewalk-between-houses-toronto.jpg" width="1200" height="1600" alt="Newly formed concrete sidewalk between two houses" loading="lazy" decoding="async" /></div>
      <div class="gtile wide reveal"><img src="/assets/img/concrete-driveway-fresh-pour-toronto.jpg" width="1244" height="1600" alt="Freshly poured concrete driveway at a home" loading="lazy" decoding="async" /></div>
      <div class="gtile reveal"><img src="/assets/img/new-concrete-front-walkway-toronto.jpg" width="1200" height="1600" alt="Freshly poured concrete front walkway at a home" loading="lazy" decoding="async" /></div>
    </div>
  </div>
</section>

<!-- ============== RELATED LINKS ============== -->
<section class="section related">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="kicker">Service areas</p>
      <h2>Every city we serve</h2>
    </div>
    <div class="related-grid">
      {LOCATIONS.map((l) => (
        <a class="svc-card reveal" href={`/locations/${l.slug}/`}><span class="mk">→</span><span class="body"><strong>{l.name}</strong><span>{l.blurb}</span></span><span class="go">→</span></a>
      ))}
    </div>
  </div>
</section>

<QuoteForm
  intro="Tell us where you are and what needs doing. The form takes about a minute, anywhere in our service area."
  messagePlaceholder="e.g. New driveway and front walkway, I'm in Whitby"
/>

<!-- ============== FAQ ============== -->
<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="kicker center">Good to know</p>
      <h2>Service area questions, answered</h2>
    </div>

    <div class="faq-list reveal">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-q">{f.q} <span class="pm">+</span></button>
          <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============== FINAL CTA ============== -->
<section class="section final">
  <div class="wrap">
    <h2 class="reveal">Get your free quote today</h2>
    <p class="reveal">The form takes about a minute. Fill it in and we will take it from there, wherever you are in the GTA.</p>
    <div class="btns reveal">
      <a href="#quote" class="btn btn-light">Get My Free Quote</a>
    </div>
  </div>
</section>

</Base>
