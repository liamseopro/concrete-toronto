---
import InnerPage from '../../../components/InnerPage.astro';

const faqs = [
  {
    q: 'How much does concrete work cost in Pickering?',
    a: 'It depends on the size of the job and how much prep the site needs. Every quote from Concrete Toronto is free and in writing, so you know the exact price before any work starts.',
  },
  {
    q: 'Do you serve all of Pickering, including the north end?',
    a: 'Yes. We work across Pickering, from the waterfront neighbourhoods up through Liverpool, Brock Ridge and the north end toward Claremont.',
  },
  {
    q: 'Can you pour a patio on a new-build lot?',
    a: 'Yes. New-build lots need the ground to settle before flatwork goes in, and we will tell you honestly if your yard should wait a season. When it is ready, we build a compacted base and pour.',
  },
  {
    q: 'Do you charge more to come out to Pickering?',
    a: 'No. Quotes are based on the work itself, not the distance. A house in Pickering is quoted the same way as a house in Toronto.',
  },
  {
    q: 'How do I get a quote?',
    a: 'Fill out the free quote form and we will get back to you with an estimate. Prefer to talk? Call us at (289) 906-0097.',
  },
];
---

