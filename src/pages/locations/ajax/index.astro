---
import InnerPage from '../../../components/InnerPage.astro';

const faqs = [
  {
    q: 'How is concrete work in Ajax priced?',
    a: 'It depends on the scope and the site prep, and bundling a walkway with its steps is quoted as one job, not two. Quotes are free and in writing, and never higher because of the drive out.',
  },
  {
    q: 'Do you serve all of Ajax?',
    a: 'Yes. We work across Ajax, from the lakeside neighbourhoods along the waterfront trail up through the village area and the newer north end.',
  },
  {
    q: 'Can you replace my front walk and steps together?',
    a: 'Yes, and doing them together is the smart way: one excavation, one pour schedule, and finishes that match. We quote the bundle in writing before any work starts.',
  },
  {
    q: 'Do you charge more to come out to Ajax?',
    a: 'No. Quotes are based on the work itself, not the distance. A house in Ajax is quoted the same way as a house in Toronto.',
  },
  {
    q: 'What is the quickest way to get an Ajax quote?',
    a: 'Send photos and a short description through the free quote form and we will reply with a written estimate. You can also call us at (289) 906-0097.',
  },
];
