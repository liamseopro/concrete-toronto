    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Concrete Toronto. All rights reserved.</span>
      <span>Concrete · Parging · Serving Toronto &amp; the GTA</span>
    </div>
  </div>
</footer>

<div class="sticky-cta" id="stickyCta">
  <a href="#quote" class="btn btn-primary">Get a Free Quote</a>
</div>

<script>
import '../scripts/main.js';
</script>
</body>
</html>
